{
  "$schema": "https://raw.githubusercontent.com/nicklasad/tauri-config-schema/main/schema.json",
  "productName": "Johnny Pet",
  "version": "0.1.0",
  "identifier": "com.johnny-pet.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"],
    "resources": []
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.anthropic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; script-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Johnny Pet",
        "width": 300,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "x": 100,
        "y": 100
      },
      {
        "label": "chat",
        "title": "Johnny Chat",
        "width": 340,
        "height": 440,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "shadow": false,
        "x": 420,
        "y": 100
      }
    ]
  }
}
